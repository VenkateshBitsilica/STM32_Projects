void delay(uint32_t n)
{
	uint32_t i,j;
	for(i=0; i<n;i++)
		for(j=0;j<1000;j++);
}
/*
* PB14 --> SPI2_MISO
* PB15 --> SPI2_MOSI
* PB13 --> SPI2_SCLK
* PB12 --> SPI2_NSS
*/

#include <stdint.h>

/* -------- I2C Peripheral Base Address -------- */
#define I2C1_BASE 0x40005400UL

/* -------- I2C Peripheral Register Map -------- */
typedef struct {
    volatile uint32_t CR1;
    volatile uint32_t CR2;
    volatile uint32_t OAR1;
    volatile uint32_t OAR2;
    volatile uint32_t TIMINGR;
    volatile uint32_t TIMEOUTR;
    volatile uint32_t ISR;
    volatile uint32_t ICR;
    volatile uint32_t PECR;
    volatile uint32_t RXDR;
    volatile uint32_t TXDR;
} I2C_TypeDef;

#define I2C1 ((I2C_TypeDef *)I2C1_BASE)

/* -------- I2C Handle Structure -------- */
typedef struct {
    I2C_TypeDef *Instance;   // Pointer to I2C peripheral
    uint32_t Timing;         // Timing register value
} I2C_HandleTypeDef;

/* -------- I2C Init Function -------- */
void I2C_Init1(I2C_HandleTypeDef *hi2c) {
    hi2c->Instance->CR1 &= ~(1 << 0);         // Disable PE
    hi2c->Instance->TIMINGR = hi2c->Timing;   // Set timing
    hi2c->Instance->CR1 |= (1 << 0);          // Enable PE
}

/* -------- I2C Start Write Transfer -------- */
void I2C_Start(I2C_HandleTypeDef *hi2c, uint8_t addr, uint8_t len) {
    hi2c->Instance->CR2 = ((addr & 0x7F) << 1) |  // 7-bit address
                          (len << 16) |           // NBYTES
                          (1 << 13)     |         // AUTOEND
                          (0 << 10)     |         // Write (RD_WRN = 0)
                          (1 << 0);               // START
}

/* -------- I2C Send Byte -------- */
void I2C_SendByte(I2C_HandleTypeDef *hi2c, uint8_t data) {
    while (!(hi2c->Instance->ISR & (1 << 0))); // Wait TXIS
    hi2c->Instance->TXDR = data;
}

/* -------- I2C Wait for STOP and Clear -------- */
void I2C_WaitStop(I2C_HandleTypeDef *hi2c) {
    while (!(hi2c->Instance->ISR & (1 << 5)));  // Wait STOPF
    hi2c->Instance->ICR |= (1 << 5);            // Clear STOPF
}

/* -------- Example Main -------- */
int main(void) {
    I2C_HandleTypeDef hi2c1;
    hi2c1.Instance = I2C1;
    hi2c1.Timing = 0x10420F13; // For 100kHz @ 8MHz peripheral clock

    I2C_Init1(&hi2c1);

    // Send 0xA5 to slave 0x3C
    I2C_Start(&hi2c1, 0x68, 1);
    I2C_SendByte(&hi2c1, 0xA5);
    I2C_WaitStop(&hi2c1);

    while (1); // Loop forever
}
