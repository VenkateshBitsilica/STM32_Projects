
#include "i2c_driver.h"

/*
 * Peripheral Clock Setup
 */
void I2C_PclkControl(I2C_TypeDef *pI2Cx, uint8_t EnorDi)
{
	if(EnorDi == ENABLE)
	{
		if(pI2Cx == I2C1)
			I2C1_PCLK_EN();
		else if(pI2Cx == I2C2)
			I2C2_PCLK_EN();
		else if(pI2Cx == I2C3)
			I2C3_PCLK_EN();
	}
	else
	{
		if(pI2Cx == I2C1)
			I2C1_PCLK_DI();
		else if(pI2Cx == I2C2)
			I2C2_PCLK_DI();
		else if(pI2Cx == I2C3)
			I2C3_PCLK_DI();
	}
}

/*
 * I2C Init & Deinit
 */
void I2C_Init(I2C_Handle_t *pI2CHandle)
{
    //uint32_t tempreg = 0;

    // 1. Enable peripheral clock
    I2C_PclkControl(pI2CHandle->pI2Cx, ENABLE);

    // 2. Disable the peripheral before configuring
    I2C_PeripheralControl(pI2CHandle->pI2Cx, DISABLE);

    // 3. Configure Timing Register (for 100kHz, assuming 16 MHz peripheral clock)
    pI2CHandle->pI2Cx->TIMINGR = (uint32_t)0x10420A28;		//0x00303D5B  // 100kHz @ 16MHz

    // 4. Configure Own Address
    pI2CHandle->pI2Cx->OAR1 &= ~(1 << 15);  // Disable before config
    pI2CHandle->pI2Cx->OAR1 = (0 << 10) | (pI2CHandle->I2C_config.I2C_DeviceAddress << 1);  // 7-bit address
    pI2CHandle->pI2Cx->OAR1 |= (1 << 15);  // Enable own address

     //5. Enable ACK will be used only for Salve mode
    if(pI2CHandle->I2C_config.I2C_ACKControl == I2C_ACK_ENABLE)
        pI2CHandle->pI2Cx->CR2 |= I2C_CR2_NACK;  // In STM32L4, this bit logic is reversed

    // 6. Enable the peripheral
    I2C_PeripheralControl(pI2CHandle->pI2Cx, ENABLE);
}


void I2C_Deinit(I2C_TypeDef *pI2Cx)
{
	if(pI2Cx == I2C1)
		I2C1_REG_RST();
	else if(pI2Cx == I2C2)
		I2C2_REG_RST();
	else if(pI2Cx == I2C3)
		I2C3_REG_RST();
}

void I2C_GenerateStart(I2C_TypeDef *pI2Cx)
{
	pI2Cx->CR2 |= I2C_CR2_START;
}
void I2C_GenerateStop(I2C_TypeDef *pI2Cx)
{
	pI2Cx->CR2 |= I2C_CR2_STOP;
}

uint8_t I2C_GetFlagStatus(I2C_TypeDef *pI2Cx , uint32_t FlagName)
{
	if(pI2Cx->ISR & FlagName)
	{
		return SET;
	}
	return RESET;
}

/*
 * Data Send and Receive
 */
void I2C_MasterSendData(I2C_TypeDef *pI2Cx, uint8_t *pTxBuffer, uint32_t len, uint8_t SlaveAddr)
{
    // 1. Wait until I2C is not busy
    while(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_BUSY));

    // 2. Configure CR2
    pI2Cx->CR2 &= ~(I2C_CR2_SADD | I2C_CR2_NBYTES | I2C_CR2_RD_WRN |
                    I2C_CR2_START | I2C_CR2_AUTOEND);

    pI2Cx->CR2 |= ((SlaveAddr << 1) & I2C_CR2_SADD);
    pI2Cx->CR2 |= (len << I2C_CR2_NBYTES_Pos);
    pI2Cx->CR2 &= ~I2C_CR2_RD_WRN;      // Write mode
    pI2Cx->CR2 |= I2C_CR2_START;

    // 3. Transmit all bytes
    while(len > 0)
    {
        while(!(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_TXIS)));
        pI2Cx->TXDR = *pTxBuffer++;
        len--;
    }

    // 4. Wait for Transfer Complete
    while(!(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_TC)));

    // 5. Generate STOP as we are not using AUTOEND for automatic STOP
    I2C_GenerateStop(pI2Cx);

    // 6. Wait for STOPF and clear it
    while(!(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_STOPF)));
    pI2Cx->ICR |= I2C_ICR_STOPCF;
}

void I2C_MasterReceiveData(I2C_TypeDef *pI2Cx, uint8_t *pRxBuffer, uint32_t len, uint8_t SlaveAddr)
{
    // 1. Wait until bus is free
    while(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_BUSY));

    // 2. Configure CR2 with slave address, read mode, number of bytes, auto stop
    pI2Cx->CR2 &= ~(I2C_CR2_SADD | I2C_CR2_NBYTES | I2C_CR2_RD_WRN |
                    I2C_CR2_START | I2C_CR2_AUTOEND);

    pI2Cx->CR2 |= ((SlaveAddr << 1) & I2C_CR2_SADD);
    pI2Cx->CR2 |= (len << I2C_CR2_NBYTES_Pos);
    pI2Cx->CR2 |= I2C_CR2_RD_WRN;       // Read mode
    pI2Cx->CR2 |= I2C_CR2_START;
    pI2Cx->CR2 |= I2C_CR2_AUTOEND;

    // 3. Read all data
    while(len > 0)
    {
        while(!(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_RXNE)));
        *pRxBuffer++ = pI2Cx->RXDR;
        len--;
    }

    // 4. Wait until STOPF is set
    while(!(I2C_GetFlagStatus(pI2Cx, I2C_FLAG_STOPF)));

    // 5. Clear STOPF
    pI2Cx->ICR |= I2C_ICR_STOPCF;
}


/*
 * IRQ Configuration and ISR handling
 */
void I2C_IRQConfig(uint8_t IRQNumber, uint8_t IRQPriority, uint8_t EnorDi)
{
	if(EnorDi == ENABLE)
	{
		if(IRQNumber < 32)
			NVIC->ISER[0] |= (1 << IRQNumber);
		else if(IRQNumber < 64)
			NVIC->ISER[1] |= (1 << (IRQNumber % 32));

		NVIC_SetPriority(IRQNumber, IRQPriority);
	}
	else
	{
		if(IRQNumber < 32)
			NVIC->ICER[0] |= (1 << IRQNumber);
		else if(IRQNumber < 64)
			NVIC->ICER[1] |= (1 << (IRQNumber % 32));
	}
}

