
#include "uart_driver.h"

/*
 * Peripheral Clock setup
 */
void USART_PeriClockControl(USART_TypeDef *pUSARTx, uint8_t EnOrDi)
{
	if(EnorDi == ENABLE)
	{
		if(pUSARTx == USART1)
			USART1_PCLK_EN();
		else if(pUSARTx == USART2)
			USART2_PCLK_EN();
		else if(pUSARTx == USART3)
			USART3_PCLK_EN();
		else if(pUSARTx == UART4)
			UART4_PCLK_EN();
		else if(pUSARTx == UART5)
			UART5_PCLK_EN();
	}
	else
	{
		if(pUSARTx == USART1)
			USART1_PCLK_DI();
		else if(pUSARTx == USART2)
			USART2_PCLK_DI();
		else if(pUSARTx == USART3)
			USART3_PCLK_DI();
		else if(pUSARTx == UART4)
			UART4_PCLK_DI();
		else if(pUSARTx == UART5)
			UART5_PCLK_DI();
	}
}

/*
 * Init and De-init
 */
void USART_Init(USART_Handle_t *pUSARTHandle)
{

}
void USART_DeInit(USART_TypeDef *pUSARTx)
{
	if(pUSARTx == USART1)
		USART1_REG_RST();
	else if(pUSARTx == USART2)
		USART2_REG_RST();
	else if(pUSARTx == USART3)
		USART3_REG_RST();
	else if(pUSARTx == UART4)
		UART4_REG_RST();
	else if(pUSARTx == UART5)
		UART5_REG_RST();
}

