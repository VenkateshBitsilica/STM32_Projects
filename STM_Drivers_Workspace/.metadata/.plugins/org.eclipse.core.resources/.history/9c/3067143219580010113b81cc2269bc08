#include "uart_driver.h"
#include <string.h>

/*
 * PA9  -> USART1_TX
 * PA10 -> USART1_RX
 * Baud Rate: 9600
 */

USART_Handle_t uarthandle;
uint8_t tx_buffer[] = "Hello from STM32\r\n";
uint8_t rx_buffer[32];
uint8_t tx_complete = 0;
uint8_t rx_complete = 0;
uint8_t len = 0;

void delay(uint32_t n)
{
	for (uint32_t i = 0; i < n; i++)
		for (volatile uint32_t j = 0; j < 1000; j++);
}

void UART_GPIOInits(void)
{
	GPIO_PclkControl(GPIOA, ENABLE);

	GPIO_Handle_t UARTPins;
	UARTPins.pGPIOx = GPIOA;
	UARTPins.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_AFN;
	UARTPins.GPIO_PinConfig.GPIO_PinAltFunMode = 7;
	UARTPins.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
	UARTPins.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;
	UARTPins.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;

	// TX
	UARTPins.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_9;
	GPIO_Init(&UARTPins);

	// RX
	UARTPins.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_10;
	GPIO_Init(&UARTPins);
}

void uart_init(void)
{
	uarthandle.pUSARTx = USART1;
	uarthandle.USART_Config.USART_Mode = USART_MODE_TXRX;
	uarthandle.USART_Config.USART_WordLength = USART_WORDLEN_8BITS;
	uarthandle.USART_Config.USART_Baud = USART_STD_BAUD_9600;
	uarthandle.USART_Config.USART_HWFlowControl = USART_HW_FLOW_CTRL_NONE;
	uarthandle.USART_Config.USART_NoOfStopBits = USART_STOPBITS_1;
	uarthandle.USART_Config.USART_ParityControl = USART_PARITY_DISABLE;

	USART_Init(&uarthandle);
}

void btn_init(void)
{
	GPIO_Handle_t pGPIOBtn;
	GPIO_PclkControl(GPIOC, ENABLE);
	pGPIOBtn.pGPIOx = GPIOC;
	pGPIOBtn.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_13;
	pGPIOBtn.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
	pGPIOBtn.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	pGPIOBtn.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

	GPIO_Init(&pGPIOBtn);
}

int main(void)
{
	UART_GPIOInits();
	uart_init();
	btn_init();

	len = strlen((char *)tx_buffer);

	// IRQ config
	USART_IRQConfig(USART1_IRQn, 5, ENABLE);

	while (1)
	{
		while (GPIO_ReadInputPin(GPIOC, GPIO_PIN_NO_13) == SET);
		delay(200);

		tx_complete = 0;
		rx_complete = 0;

		// Clear rx buffer
		memset(rx_buffer, 0, sizeof(rx_buffer));

		// Start TX and RX
		USART_ReceiveDataIT(&uarthandle, rx_buffer, len);
		USART_SendDataIT(&uarthandle, tx_buffer, len);

		// Wait until done
		while (!(tx_complete && rx_complete));

		// At this point, rx_buffer holds received data
		delay(1000);  // optional delay
	}
}

// User-defined application callback
void USART_ApplicationEventCallback(USART_Handle_t *pUSARTHandle, uint8_t AppEv)
{
	if (AppEv == USART_EVENT_TX_CMPLT)
	{
		tx_complete = 1;
	}
	else if (AppEv == USART_EVENT_RX_CMPLT)
	{
		rx_complete = 1;
	}
}
