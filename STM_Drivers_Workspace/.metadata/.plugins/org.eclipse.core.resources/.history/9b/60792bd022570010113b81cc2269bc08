void I2C_Deinit(I2C_TypeDef *pI2Cx)
{
	if(pI2Cx == I2C1)
		I2C1_REG_RST();
	else if(pI2Cx == I2C2)
		I2C2_REG_RST();
	else if(pI2Cx == I2C3)
		I2C3_REG_RST();
}

