/*
 * Other Peripheral Control API's
 */
void I2C_PeripheralControl(I2C_TypeDef *pI2Cx, uint8_t EnOrDi)
{
	if(EnOrDi == ENABLE)
		pI2Cx->CR1 |= I2C_CR1_PE;
	else
		pI2Cx->CR1 &= ~I2C_CR1_PE;
}

